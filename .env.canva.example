# Canva Connect API — Phase C1 (OAuth Foundation)
# สร้าง integration ที่ https://www.canva.com/developers/ (บัญชี Canva ต้องเปิด MFA ก่อน)
# 1) Create an integration → เลือกชนิด integration (dev ใช้งานเองก่อน ไม่ต้อง submit review)
# 2) คัดลอก Client ID และกด Generate secret → Client secret (ดูได้ครั้งเดียว)
# 3) Scopes: profile:read, asset:read, asset:write, design:meta:read,
#    design:content:read, design:content:write
# 4) Authorized redirects (local dev):
#      http://127.0.0.1:3000/api/canva/callback
#    (Canva ไม่รับ localhost — ต้องเป็น 127.0.0.1; production ใส่โดเมนจริง /api/canva/callback)
# 5) กรอกค่าด้านล่างใน .env ของเครื่อง (ไม่ commit ขึ้น repo)

CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
# ปล่อยว่าง = สร้างอัตโนมัติจาก origin ของ request (แนะนำสำหรับ local)
CANVA_REDIRECT_URI=
