{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "trailingSlash": false,
  "buildCommand": "rm -rf public && pnpm exec vite build && cp -r client/public/tool public/tool && pnpm exec esbuild api/index.ts --platform=node --packages=external --bundle --format=esm --outfile=api/handler.js",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/handler" },
    { "source": "/tool", "destination": "/index.html" },
    { "source": "/tools", "destination": "/index.html" },
    { "source": "/tool/editor", "destination": "/tool/editor/index.html" },
    { "source": "/((?!api|media|tool/).*)", "destination": "/index.html" }
  ]
}
