{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "trailingSlash": false,
  "buildCommand": "rm -rf public && pnpm exec vite build",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/manus-storage/:path*", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
